// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  configId    String
  configSnapshot      Json
  eventPayload     Json
    createdAt      DateTime @default(now()) @db.Timestamptz(3)
}






model NotificationDelivery {
  id          String @id @default(uuid())
    notificationId String
notificationPreferenceId String
channelSnapshot String
destinationSnapshot String
status String
sentAt DateTime @default(now()) @db.Timestamptz(3)
deliveredAt DateTime @db.Timestamptz(3)
errorCode String
errorMessage String
}




model NotificationPreference {
  Id          String @id @default(uuid())
configId String
destinationId String?

@@unique([destinationId, configId], map: "preference_destination_configId_unique")
}


model NotificationConfig {
  Id          String @id @default(uuid())
userId String
config Json
enabled Boolean
createdAt DateTime @default(now()) @db.Timestamptz(3)
updatedAt DateTime @db.Timestamptz(3)
}

model OAuthState {
  id          String @id @default(uuid())
    userId String
provider String
state String
metadata Json
expiresAt DateTime @db.Timestamptz(3)
usedAt DateTime? @db.Timestamptz(3)
createdAt DateTime @db.Timestamptz(3)
}


model OAuthConnection {
  id          String @id @default(uuid())
    userId String
provider String
providerAccountId String
authData Json
createdAt DateTime @db.Timestamptz(3)

@@unique([userId, provider, providerAccountId], map: "userId_provider_providerAccountId_unique")
}

model Destination {
  id          String @id @default(uuid())
    userId String
channelType String
createdAt DateTime @db.Timestamptz(3)
metadata Json
oAuthConnectionId String?

}



model Consent {
  id          String @id @default(uuid())
    destinationId String @unique(map: "consent_destination_unique")
status String
createdAt DateTime @db.Timestamptz(3)
updatedAt DateTime @db.Timestamptz(3)
}


model ConsentEvent {
  id          String @id @default(uuid())
    destinationId String
status String
createdAt DateTime @db.Timestamptz(3)
}

