{
  "name": "shared-notification",
  "version": "0.1.0",
  "scripts": {
    "build": "echo \"The build step is not required when using JavaScript!\" && exit 0",
    "cdk": "cdk",
    "test": "jest",
    "prettier": "prettier --config package.json --write .",
    "startDevDB": "docker compose -f docker-compose.dev.yml up -d",
    "stopDevDB": "docker compose -f docker-compose.dev.yml down",
    "startTestDB": "docker compose -f docker-compose.test.yml up -d",
    "runTestDBMigrationDeploy": "npx prisma migrate deploy",
    "stopTestDB": "docker compose -f docker-compose.test.yml down"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "esbuild-loader": "^4.4.3",
    "jest": "^30",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "aws-cdk-lib": "2.256.1",
    "constructs": "^10.5.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "prettierignore": [
    "node_modules",
    "build",
    "dist",
    "*.log",
    "package-lock.json"
  ]
}
